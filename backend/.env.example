APP_ENV=development
RUST_LOG=info
DATABASE_URL=postgres://epp_lab:epp_lab@localhost:5433/epp_lab
ADMIN_BIND=0.0.0.0:8080
EPP_BIND=0.0.0.0:700
EPP_TLS_CERT=/path/to/server.crt
EPP_TLS_KEY=/path/to/server.key
EPP_CLIENT_CA=/path/to/client-ca.crt
EPP_READ_TIMEOUT=300
EPP_TLS_HANDSHAKE_TIMEOUT=10
EPP_WRITE_TIMEOUT=30
EPP_IDLE_TIMEOUT=900
EPP_SHUTDOWN_GRACE_PERIOD=10
TCP_KEEPALIVE_IDLE=60
TCP_KEEPALIVE_INTERVAL=30
TCP_KEEPALIVE_RETRIES=5
EPP_MAX_FRAME_SIZE=1048576
EPP_OBJECT_URIS=urn:ietf:params:xml:ns:domain-1.0
EPP_EXTENSION_URIS=
